      "classical_recording_place",
      "classical_recording_place_id",
      "classical_recording_area",
      "classical_recording_date_begin",
      "classical_recording_date_end"
    ]
  },
  "excluded_context": [
    "other recordings of fetched works",
    "forward derivatives and arrangements",
    "quarantined source relationships",
    "roles inferred only from titles",
    "guessed work hierarchy"
  ]
}
